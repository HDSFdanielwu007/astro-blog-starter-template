/**
 * Cloudflare Worker —— 硅基流动 AI 摘要代理
 *
 * 作用：把硅基流动的 API key 藏在服务端，前端只调用本 Worker 地址，
 *       避免 key 暴露在浏览器代码里。
 *
 * 部署步骤：
 *   1. 登录 https://dash.cloudflare.com
 *   2. 左侧菜单 → Workers & Pages → 创建 → 创建 Worker
 *   3. 给 Worker 起个名字（如 sci-ai-summary）
 *   4. 打开「设置」→「变量和机密」→ 添加一个「机密」(Secret)：
 *      名称: SILICONFLOW_API_KEY
 *      值:  你的硅基流动 key（sk-开头）
 *   5. 把本文件内容粘贴到 Worker 编辑器，点击「部署」
 *   6. 得到地址形如 https://sci-ai-summary.你的子域.workers.dev
 *   7. 把该地址填到科研助手平台「AI 后端地址」输入框
 *
 * 注意：本 Worker 已做基本 CORS 放开，便于前端跨域调用。
 */

const SILICONFLOW_BASE = 'https://api.siliconflow.cn/v1/chat/completions';

// 允许的模型白名单，防止前端被滥用去调其他模型
const ALLOWED_MODELS = new Set([
  'deepseek-ai/DeepSeek-V3',
  'deepseek-ai/DeepSeek-R1',
  'Qwen/Qwen2.5-72B-Instruct',
  'Qwen/Qwen2.5-14B-Instruct',
  'Qwen/Qwen2.5-7B-Instruct',
  'THUDM/glm-4-9b-chat'
]);

export default {
  async fetch(request, env, ctx) {
    // 处理 CORS 预检请求
    if (request.method === 'OPTIONS') {
      return new Response(null, {
        status: 204,
        headers: corsHeaders()
      });
    }

    // 仅允许 POST
    if (request.method !== 'POST') {
      return json({ error: '仅支持 POST 请求' }, 405);
    }

    // 简单路径校验（可选：只接受 /v1/chat/completions 或根路径）
    const url = new URL(request.url);
    if (url.pathname !== '/v1/chat/completions' && url.pathname !== '/') {
      return json({ error: '路径不存在' }, 404);
    }

    // 读取前端传入的请求体
    let body;
    try {
      body = await request.json();
    } catch (e) {
      return json({ error: '请求体不是合法 JSON' }, 400);
    }

    const model = body.model;
    if (!model || !ALLOWED_MODELS.has(model)) {
      return json({ error: '模型不在白名单内: ' + (model || '(空)') }, 400);
    }

    const apiKey = env.SILICONFLOW_API_KEY;
    if (!apiKey) {
      return json({ error: '服务端未配置 SILICONFLOW_API_KEY' }, 500);
    }

    try {
      const upstream = await fetch(SILICONFLOW_BASE, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + apiKey
        },
        body: JSON.stringify({
          model: model,
          messages: body.messages || [],
          temperature: typeof body.temperature === 'number' ? body.temperature : 0.3,
          max_tokens: typeof body.max_tokens === 'number' ? body.max_tokens : 1024
        })
      });

      const upstreamBody = await upstream.text();
      let data;
      try {
        data = JSON.parse(upstreamBody);
      } catch (e) {
        data = { error: upstreamBody };
      }

      // 透传上游状态码与结果
      return new Response(JSON.stringify(data), {
        status: upstream.status,
        headers: {
          'Content-Type': 'application/json',
          ...corsHeaders()
        }
      });
    } catch (e) {
      return json({ error: '调用硅基流动失败: ' + e.message }, 502);
    }
  }
};

function corsHeaders() {
  return {
    'Access-Control-Allow-Origin': '*',
    'Access-Control-Allow-Methods': 'POST, OPTIONS',
    'Access-Control-Allow-Headers': 'Content-Type, Authorization'
  };
}

function json(obj, status) {
  return new Response(JSON.stringify(obj), {
    status: status || 200,
    headers: {
      'Content-Type': 'application/json',
      ...corsHeaders()
    }
  });
}
